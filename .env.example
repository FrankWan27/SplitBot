# Copy this file to .env and fill in the values. .env is gitignored: the token is
# a password and must never be committed.

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional. Set to your server's id while developing so `npm run deploy`
# registers commands to that one server and they appear instantly, rather than
# globally with up to an hour of propagation delay.
DISCORD_GUILD_ID=

# Optional. Defaults to ./data/splits.db
DATABASE_PATH=
