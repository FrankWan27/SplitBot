{
  "name": "discord-split-bot",
  "version": "1.0.0",
  "description": "Discord bot for splitting bills between friends",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "node dist/deploy-commands.js",
    "dev": "tsc && node dist/index.js",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "lint": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
